generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  INVENTORY_MANAGER
  WAREHOUSE_MANAGER
  PROCUREMENT_OFFICER
  STOREKEEPER
  VIEWER
}

enum MoveType {
  IN
  OUT
  TRANSFER
  ADJUST
}

enum POStatus {
  DRAFT
  APPROVED
  SENT
  RECEIVED
  CANCELLED
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  AuditLog     AuditLog[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  items Item[]
}

model Warehouse {
  id     Int          @id @default(autoincrement())
  name   String       @unique
  city   String
  levels StockLevel[]
}

model Supplier {
  id    Int             @id @default(autoincrement())
  name  String          @unique
  email String?
  phone String?
  items Item[]
  pos   PurchaseOrder[]
}

model Item {
  id           Int             @id @default(autoincrement())
  sku          String          @unique
  barcode      String          @unique
  name         String
  categoryId   Int
  category     Category        @relation(fields: [categoryId], references: [id])
  supplierId   Int
  supplier     Supplier        @relation(fields: [supplierId], references: [id])
  unitCost     Decimal         @db.Decimal(12, 2)
  reorderPoint Int
  reorderQty   Int
  isAsset      Boolean         @default(false)
  levels       StockLevel[]
  movements    StockMovement[]
  POLine       POLine[]
}

model StockLevel {
  itemId      Int
  warehouseId Int
  quantity    Int       @default(0)
  item        Item      @relation(fields: [itemId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([itemId, warehouseId])
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  itemId      Int
  warehouseId Int
  type        MoveType
  qty         Int
  reference   String?
  userId      Int
  createdAt   DateTime @default(now())
  item        Item     @relation(fields: [itemId], references: [id])

  @@index([itemId, createdAt])
}

model PurchaseOrder {
  id         Int        @id @default(autoincrement())
  number     String     @unique
  supplierId Int
  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  status     POStatus   @default(DRAFT)
  auto       Boolean    @default(false)
  createdAt  DateTime   @default(now())
  lines      POLine[]
}

model POLine {
  id       Int           @id @default(autoincrement())
  poId     Int
  itemId   Int
  qty      Int
  unitCost Decimal       @db.Decimal(12, 2)
  po       PurchaseOrder @relation(fields: [poId], references: [id])
  item     Item          @relation(fields: [itemId], references: [id])
}

model AssetAssignment {
  id          Int       @id @default(autoincrement())
  tag         String    @unique
  itemId      Int
  employee    String
  department  String
  warehouseId Int
  issuedAt    DateTime  @default(now())
  returnedAt  DateTime?
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  detail    String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}